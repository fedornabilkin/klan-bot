{
  "name": "@klan/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup:local": "node ../Scripts/prepare-local.mjs",
    "dev": "node --import tsx --watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "check:config": "node --import tsx src/main.ts --check-config",
    "check:config:built": "node dist/main.js --check-config",
    "start": "node dist/main.js",
    "test:setup": "node --test ../Scripts/prepare-local.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
