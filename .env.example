NODE_ENV=development
# Same BotFather token as the API. Only this worker may call getUpdates.
TELEGRAM_BOT_TOKEN=
# API origin, without a path or trailing slash. Use a private network or HTTPS.
BOT_BACKEND_URL=http://127.0.0.1:3001
# Same random secret as BOT_INTERNAL_SECRET in the API (32..256 non-space ASCII characters).
BOT_BACKEND_SECRET=
# Keep runtime state outside the repository. Relative to the bot working directory.
BOT_STATE_FILE=../ops/runtime/bot/offset.json
