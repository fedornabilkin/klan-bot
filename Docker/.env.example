# Same BotFather token as the API. Only one worker may call getUpdates.
TELEGRAM_BOT_TOKEN=
# Same secret as BOT_INTERNAL_SECRET in the API (32..256 non-space ASCII characters).
BOT_BACKEND_SECRET=
CONTAINER_BACKEND_URL=http://host.docker.internal:3001
# Used by Docker/compose.network.yaml; API has DNS alias api.
KLAN_NETWORK=klan
