# Server /opt/klan/bot/shared/runtime.env (created once by the installer).
# Optional legacy GitHub PRODUCTION_ENV replaces the complete server file for a release.
# Raw KEY=value lines: do not quote values or use export/interpolation.
# Same BotFather token as the production API; exactly one polling worker.
TELEGRAM_BOT_TOKEN=
# Same value as BOT_INTERNAL_SECRET in the production API.
# 32..256 non-space ASCII characters; use a generated random secret.
BOT_BACKEND_SECRET=
# API origin without path/trailing slash. Remote API needs a trusted private route or TLS.
BOT_BACKEND_URL=http://api:3001
# NODE_ENV and BOT_STATE_FILE are fixed by production Compose.
