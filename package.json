{
  "name": "@klan/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "check:config": "tsx src/main.ts --check-config",
    "check:config:built": "node dist/main.js --check-config",
    "start": "node dist/main.js"
  },
  "dependencies": { "dotenv": "^17.2.3" },
  "devDependencies": { "@types/node": "^24.10.0", "tsx": "^4.20.6", "typescript": "^5.9.3" }
}
